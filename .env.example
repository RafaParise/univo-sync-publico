# Copie para .env (o .env NÃO vai para o git).

# ===== FortiGate 60D (scripts/provisionar_rede.py) =====
# Nova senha do admin: 8 a 64 caracteres, sem espaço, aspas ou barra invertida.
ADMIN_SENHA=
# MAC da placa com fio do PC Ryzen (porta 1). Formato AA:BB:CC:DD:EE:FF
MAC_RYZEN=
# MAC do adaptador de rede do hub Ugreen do A12 (não é o Wi-Fi do celular).
MAC_A12=
# Opcionais: controles fixos da ARENA (recebem 10.0.30.10 e 10.0.30.11).
MAC_CONTROLE_1=
MAC_CONTROLE_2=
# Plano B (cabo console): porta COM. Vazio = detecção automática.
PORTA_SERIAL=
# Preenchidos pelos scripts: FORTIGATE_IP, FORTIGATE_CERT_SHA256,
# FORTIGATE_API_USUARIO, FORTIGATE_API_SENHA

# ===== parise-infra (docker-compose.yml; o bootstrap.sh gera o PARISE_TOKEN) =====
# Chave em https://login.tailscale.com/admin/settings/keys
# Prefira uma chave de uso único com tag: depois do 1º login o estado fica em data/tailscale.
TS_AUTHKEY=
TS_HOSTNAME=parise-hub
# Redes que o Tailscale anuncia. Na bancada: LAN1 do FortiGate (separe várias por vírgula).
LAN_CIDR=10.0.20.0/24
# Domínio interno: o DNS do FortiGate responde <nome>.bancada.lan (scripts/projetos_infra.py dns)
DOMAIN=bancada.lan
# IP da máquina que roda esta pilha (os sites apontam para ele) e URL da API
HUB_IP=
PARISE_CORE_URL=
# Token da API do parise-core (gerado automaticamente)
PARISE_TOKEN=
